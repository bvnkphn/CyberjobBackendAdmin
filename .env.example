NODE_ENV=development
PORT=3001

# ฐานข้อมูลเดียวกับ API ฝั่ง member (repo member เป็นเจ้าของ migration)
DATABASE_URL=postgresql://cyberjob:cyberjob-local-pass@localhost:5432/cyberjob?schema=public

# เว็บ admin ที่อนุญาตให้เรียก (คั่นด้วยจุลภาค)
CORS_ORIGIN=http://localhost:3101

# ต้องตรงกับ JWT_ACCESS_SECRET ของ API ฝั่ง member เพราะใช้ token ชุดเดียวกัน
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
